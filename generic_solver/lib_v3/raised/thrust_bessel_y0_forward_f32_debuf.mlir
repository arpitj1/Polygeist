      %226 = arith.addf %220, %225 : f32
      %227 = arith.mulf %226, %cst_6 : f32
      %228 = math.sqrt %in : f32
      %229 = arith.divf %227, %228 : f32
      %230 = arith.select %8, %159, %229 : f32
      linalg.yield %230 : f32
    } -> tensor<?xf32>
    %6 = polygeist.submapInverse(%0, %5, %2) {map = #map} : (tensor<?xf32>, tensor<?xf32>, index) -> tensor<?xf32>
    %7 = bufferization.to_memref %6 : memref<?xf32>
    memref.copy %7, %arg2 : memref<?xf32> to memref<?xf32>
    return
  }
}

