      ],
      "target": {
        "library": "PVA",
        "call": "pvaGaussianFilterSubmit",
        "backends": [
          "pva"
        ],
        "runtime_adapter": {
          "schema": 1,
          "kind": "typed_c_wrapper",
          "entry": "polygeist_pva_gaussian_3x3_u8",
          "arguments": [
            "h",
            "w",
            {
              "configuration": "sigma_x",
              "type": "float"
            },
            {
              "configuration": "sigma_y",
              "type": "float"
            },
            "input",
